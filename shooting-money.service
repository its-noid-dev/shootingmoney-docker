[Unit]
Description=Shooting Money dedicated game server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=shooting-money
Group=shooting-money
WorkingDirectory=/opt/shooting-money
Environment=HOME=/var/lib/shooting-money
Environment=SERVER_PORT=24291
ExecStart=/opt/shooting-money/ShootingMoneyServer.x86_64 --headless -- --server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shooting-money

[Install]
WantedBy=multi-user.target
